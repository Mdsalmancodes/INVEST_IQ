# Copy to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=local
LOG_LEVEL=INFO
SERVICE_NAME=core-api

# Postgres — source of truth for financial data (Document 3 §8.1)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/investiq

# Redis — 3 instances by workload (Document 3 §7.7)
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6380/0
REDIS_SESSION_URL=redis://localhost:6381/0

# Auth (Document 3 §7.4) — generate a real random secret for anything beyond local dev
JWT_SECRET=change-me-to-a-long-random-value-in-real-environments
JWT_KID=default
# JWT_PREVIOUS_SECRET and JWT_PREVIOUS_KID support zero-downtime secret
# rotation — set both when rotating jwt_secret so tokens signed with the
# previous secret still verify until they naturally expire. Leave unset
# (commented out) outside of an active rotation.
# JWT_PREVIOUS_SECRET=
# JWT_PREVIOUS_KID=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# ai-service integration (Document 3 §7.1's MockAiServiceClient pattern) —
# "mock" is correct for local dev unless you're running the ml compose profile.
AI_SERVICE_MODE=mock
AI_SERVICE_BASE_URL=http://ai-service:8000

# Phase 8 — Enterprise Security. MUST match ai-service's own
# INTERNAL_SERVICE_TOKEN exactly — this is the shared secret AiServiceClient
# sends on every request so ai-service can reject anyone who isn't core-api.
# Required (no code-level default) — generate a real random secret for
# anything beyond local dev, same as JWT_SECRET above.
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-value-in-real-environments
AI_SERVICE_REQUEST_TIMEOUT_SECONDS=30.0

# CORS — comma-separated origins, empty means nothing is allowed (fail closed)
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Rate limiting (Document 6 §15.2) — applied to every request, keyed by
# authenticated user id when available, else client IP. AI training
# endpoints (train/retrain) use the stricter override below since they're
# real model-fitting calls, not cheap DB reads.
RATE_LIMIT_REQUESTS_PER_WINDOW=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AI_TRAINING_REQUESTS_PER_WINDOW=5
RATE_LIMIT_AI_TRAINING_WINDOW_SECONDS=300

# Phase 8 — Enterprise Security. Threshold (USD) above which a portfolio
# transaction is additionally recorded as an audit-logged action per
# Document 6 §15.6.
LARGE_TRANSACTION_AUDIT_THRESHOLD_USD=10000.0

# Phase 9 — Real-Time Market Intelligence poll intervals (seconds). See
# src/config.py for the full rationale behind each default.
REALTIME_MARKET_DATA_POLL_INTERVAL_SECONDS=5.0
REALTIME_WATCHLIST_POLL_INTERVAL_SECONDS=10.0
REALTIME_PORTFOLIO_POLL_INTERVAL_SECONDS=10.0
REALTIME_AI_POLL_INTERVAL_SECONDS=30.0
REALTIME_SENTIMENT_POLL_INTERVAL_SECONDS=30.0

# Email — transactional email delivery (verification links, password reset
# links). "console" (default) logs emails to stdout via structlog instead
# of sending them, so local dev works without an API key. Set to "resend"
# in staging/production and provide a real RESEND_API_KEY.
RESEND_API_KEY=
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@investiq.ai
EMAIL_FROM_NAME=INVEST IQ
FRONTEND_URL=http://localhost:3000
