# Copy to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=local
LOG_LEVEL=INFO
SERVICE_NAME=ai-service

# Redis — cache + broker only (Document 3 §7.7; ai-service has no
# redis-session dependency of its own).
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6380/0

# Phase 7 — Hybrid AI/ML Engine settings.
CORE_API_BASE_URL=http://localhost:8001
ML_ARTIFACT_STORAGE_PATH=./data/models
ML_PREDICTION_RUN_STORAGE_PATH=./data/prediction_runs

# Phase 8 — Enterprise Security. MUST match core-api's INTERNAL_SERVICE_TOKEN
# exactly in every real environment — this is the shared secret that lets
# ai-service reject any request not coming from core-api's AiServiceClient.
INTERNAL_SERVICE_TOKEN=change-me-in-every-real-environment
