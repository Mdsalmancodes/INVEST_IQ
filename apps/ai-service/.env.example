# Copy to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=local
LOG_LEVEL=INFO
SERVICE_NAME=ai-service

# Redis — cache + broker only (Document 3 §7.7; ai-service has no
# redis-session dependency of its own).
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_BROKER_URL=redis://localhost:6380/0
