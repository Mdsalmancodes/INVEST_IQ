NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# NEXTAUTH_SECRET / NEXTAUTH_URL — placeholders for a future BFF/NextAuth
# cookie-based session layer (see middleware.ts's docstring: the real
# server-side auth cookie route is not built yet; current auth enforcement
# is entirely client-side via useAuthStore). Not read by any code today —
# next-auth is not a dependency of this app. Kept here as a forward-looking
# placeholder rather than removed, since they document a planned addition.
NEXTAUTH_SECRET=change-me-to-a-long-random-value-in-real-environments
NEXTAUTH_URL=http://localhost:3000
